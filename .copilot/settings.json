{
  "permissions": {
    "allow": [
      "bash:go get:*",
      "bash:go build:*",
      "bash:./reg:*",
      "bash:curl:*",
      "bash:pkill -f \"./reg serve\"",
      "bash:git add:*",
      "bash:git commit:*",
      "bash:pgrep:*",
      "bash:pkill:*",
      "bash:go test:*",
      "bash:go tool cover:*",
      "bash:tree:*",
      "bash:git mv:*",
      "bash:go clean:*",
      "bash:ls:*",
      "bash:wc:*",
      "bash:grep:*",
      "bash:go mod tidy:*",
      "bash:REGISTRY=http://localhost:8080 ./reg get:*",
      "bash:timeout 10 bash -c:*",
      "bash:for:*",
      "bash:do echo:*",
      "bash:REGISTRY=http://localhost:8080 ./reg set:*",
      "bash:timeout 5 bash -c:*",
      "bash:timeout 6 bash -c:*",
      "bash:timeout 3 bash -c:*",
      "bash:REGISTRY=http://localhost:8080 ./reg list:*",
      "bash:echo:*",
      "bash:netstat:*",
      "bash:GITHUB_REF:*",
      "bash:go list:*",
      "bash:GOPROXY=direct go get:*",
      "bash:git ls-remote:*",
      "bash:export REGISTRY:*",
      "bash:node --test:*",
      "bash:node --version:*",
      "bash:python3 -m json.tool:*",
      "bash:go run:*",
      "bash:jobs -l:*",
      "bash:time timeout:*",
      "bash:npm test:*",
      "web:github.com:*"
    ]
  }
}
