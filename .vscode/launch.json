    "version": "0.2.0",
    "configurations": [
        {
            "name": "serve",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": ["serve"]
        },
            {
            "name": "browse",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": ["browse"],
            "env": {
                "REGISTRY": "http://localhost:8080"
            },
            "console": "externalTerminal"
        }

    ]
}